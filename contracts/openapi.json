      "ReservedContracts": {
        "additionalProperties": false,
        "description": "Schema registry for future endpoints, NOT an HTTP response body.",
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/Conversation"
          },
          "conversation_page": {
            "$ref": "#/components/schemas/ConversationPage"
          },
          "event": {
            "discriminator": {
              "mapping": {
                "approval.requested": "#/components/schemas/ApprovalRequestedEvent",
                "message.delta": "#/components/schemas/MessageDeltaEvent",
                "run.cancel_requested": "#/components/schemas/CancelRequestedEvent",
                "run.cancelled": "#/components/schemas/RunCancelledEvent",
                "run.completed": "#/components/schemas/RunCompletedEvent",
                "run.created": "#/components/schemas/RunCreatedEvent",
                "run.failed": "#/components/schemas/RunFailedEvent",
                "run.recovery_required": "#/components/schemas/RecoveryRequiredEvent",
                "run.started": "#/components/schemas/RunStartedEvent",
                "step.started": "#/components/schemas/StepStartedEvent",
                "tool.completed": "#/components/schemas/ToolCompletedEvent",
                "tool.started": "#/components/schemas/ToolStartedEvent"
              },
              "propertyName": "event_type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunCreatedEvent"
              },
              {
                "$ref": "#/components/schemas/RunStartedEvent"
              },
              {
                "$ref": "#/components/schemas/StepStartedEvent"
              },
              {
                "$ref": "#/components/schemas/ToolStartedEvent"
              },
              {
                "$ref": "#/components/schemas/ToolCompletedEvent"
              },
              {
                "$ref": "#/components/schemas/MessageDeltaEvent"
              },
              {
                "$ref": "#/components/schemas/ApprovalRequestedEvent"
              },
              {
                "$ref": "#/components/schemas/CancelRequestedEvent"
              },
              {
                "$ref": "#/components/schemas/RunCompletedEvent"
              },
              {
                "$ref": "#/components/schemas/RunFailedEvent"
              },
              {
                "$ref": "#/components/schemas/RunCancelledEvent"
              },
              {
                "$ref": "#/components/schemas/RecoveryRequiredEvent"
              }
            ],
            "title": "Event"
          },
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "page_query": {
            "$ref": "#/components/schemas/PageQuery"
          },
          "replay_cursor": {
            "$ref": "#/components/schemas/ReplayCursor"
          },
          "run_create": {
            "$ref": "#/components/schemas/RunCreateRequest"
          },
          "run_snapshot": {
            "$ref": "#/components/schemas/RunSnapshot"
          },
          "submission_headers": {
            "$ref": "#/components/schemas/SubmissionHeaders"
          }
        },
        "required": [
          "conversation",
          "conversation_page",
          "page_query",
          "message",
          "run_create",
          "submission_headers",
          "run_snapshot",
          "replay_cursor",
