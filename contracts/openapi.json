          "revision": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "target": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          },
          "tool_name": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "proposal_id",
          "tool_name",
          "target",
          "parameters",
          "impact",
          "expires_at",
          "revision"
        ],
        "title": "ActionProposal",
        "type": "object"
      },
